generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model order {
  id                  String               @id(map: "order_pk") @db.Uuid
  date                DateTime             @db.Date
  original_price      Decimal              @default(0) @db.Decimal(8, 2)
  current_price       Decimal              @default(0) @db.Decimal(8, 2)
  status              Int                  @default(0)
  bonus_received      Decimal              @default(0) @db.Decimal(8, 2)
  user_id             String               @db.Uuid
  code                Int                  @unique(map: "code_unique") @default(autoincrement())
  additional_cost     Decimal              @default(0) @db.Decimal(8, 2)
  city                Int                  @default(0)
  description         String?
  partner_cost        Decimal              @default(0) @db.Decimal(8, 2)
  weight              Decimal              @default(0) @db.Decimal(8, 2)
  weight_rounded      Boolean              @default(false)
  order_city          city                 @relation("order_cityTocity", fields: [city], references: [id], onDelete: Restrict, map: "order_city_fk")
  order_status        order_status         @relation(fields: [status], references: [id], onDelete: Restrict, map: "status_fk")
  user                user                 @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "user_fk")
  order_tracks        order_track[]
  order_type_mappings order_type_mapping[]
  transaction         transaction[]
}

model order_status {
  id      Int      @id(map: "order_status_pk") @default(autoincrement())
  name    String   @unique(map: "name_unique") @db.VarChar(50)
  order   order[]
  message message?
}

model user {
  id            String        @id(map: "user_pk") @db.Uuid
  first_name    String        @db.VarChar(50)
  last_name     String        @db.VarChar(50)
  phone_nr      String        @db.VarChar(20)
  tg_username   String        @unique(map: "tg_username_unique") @db.VarChar(32)
  referral_code String        @unique(map: "referral_code_unique") @db.VarChar(15)
  invited_by    String?       @db.Uuid
  balance       Decimal       @default(0) @db.Decimal(8, 2)
  order         order[]
  inviter       user?         @relation("userTouser", fields: [invited_by], references: [id], map: "user_fk")
  other_user    user[]        @relation("userTouser")
  transaction   transaction[]
}

model message {
  id               Int          @id(map: "messages_pk") @default(autoincrement())
  name             String       @db.VarChar(50)
  text             String
  order_status     Int          @unique(map: "order_status_id_unique")
  order_status_ref order_status @relation(fields: [order_status], references: [id], onDelete: Restrict, map: "message_order_status_fk")
}

model city {
  id                     Int     @id(map: "city_pk") @default(autoincrement())
  name                   String  @unique(map: "city_name_unique") @db.VarChar(100)
  order_order_cityTocity order[] @relation("order_cityTocity")
}

model delivery_provider {
  id                                                           Int           @id(map: "delivery_provider_pk") @default(autoincrement())
  name                                                         String        @unique(map: "delivery_provider_name_unique") @db.VarChar(100)
  order_track_order_track_delivery_providerTodelivery_provider order_track[] @relation("order_track_delivery_providerTodelivery_provider")
}

model order_type {
  id                                                           Int                  @id(map: "order_type_pk") @default(autoincrement())
  name                                                         String               @unique(map: "order_type_name_unique") @db.VarChar(100)
  order_type_mapping_order_type_mapping_order_typeToorder_type order_type_mapping[] @relation("order_type_mapping_order_typeToorder_type")
}

model order_track {
  id                                                                 String            @id(map: "order_delivery_provider_pk") @db.Uuid
  order_id                                                           String            @db.Uuid
  delivery_provider                                                  Int
  track_number                                                       String?           @db.VarChar(255)
  delivery_provider_order_track_delivery_providerTodelivery_provider delivery_provider @relation("order_track_delivery_providerTodelivery_provider", fields: [delivery_provider], references: [id], onDelete: Cascade, map: "order_delivery_provider_delivery_provider_fk")
  order                                                              order             @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "order_delivery_provider_order_fk_1")
}

model order_type_mapping {
  id                                                   String     @id(map: "order_order_type_pk") @db.Uuid
  order_id                                             String     @db.Uuid
  order_type                                           Int
  order                                                order      @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "order_order_type_order_fk")
  order_type_order_type_mapping_order_typeToorder_type order_type @relation("order_type_mapping_order_typeToorder_type", fields: [order_type], references: [id], onDelete: Cascade, map: "order_order_type_order_type_fk")

  @@index([order_id], map: "order_order_type_order_id_idx")
}

model transaction {
  id                   String           @id(map: "transaction_pk") @db.Uuid
  datetime             DateTime         @default(now())
  order_id             String?          @db.Uuid
  user_id              String           @db.Uuid
  transaction_type     Int
  amount               Decimal          @db.Decimal(8, 2)
  order                order?           @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "transaction_order_fk")
  user                 user             @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "transaction_user_fk")
  transaction_type_ref transaction_type @relation(fields: [transaction_type], references: [id], onDelete: Restrict, map: "transaction_type_fk")
}

model transaction_type {
  id          Int           @id(map: "transaction_type_pk") @default(autoincrement())
  name        String        @unique(map: "transaction_type_name_unique") @db.VarChar(100)
  transaction transaction[]
}
